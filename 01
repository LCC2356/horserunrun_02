<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<title>Adobe-Style Glitch Poster Tool</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<style>
:root{
  --bg:#0f1115;
  --panel:#151922;
  --panel2:#10131a;
  --border:#272c38;
  --text:#e7eaf0;
  --muted:#a9b0be;
  --accent:#4aa3ff;
  --shadow:0 8px 30px rgba(0,0,0,.35);
  --radius:14px;
}
*{box-sizing:border-box;}
html,body{
  height:100%; margin:0;
  background:var(--bg);
  color:var(--text);
  font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial;
}
.container{
  height:100vh;
  display:grid;
  grid-template-columns:360px 1fr;
  gap:16px;
  padding:16px;
}
.panel{
  background:linear-gradient(180deg,var(--panel),var(--panel2));
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  overflow:auto;
}
.panel h2{
  margin:0;
  padding:14px 16px;
  border-bottom:1px solid var(--border);
  font-size:16px;
}
.group{
  padding:12px 16px;
  border-bottom:1px solid var(--border);
}
.group label{
  font-size:12px;
  color:var(--muted);
}
.group input,
.group textarea,
.group select{
  width:100%;
  margin-top:6px;
  background:#0b0d12;
  color:var(--text);
  border:1px solid var(--border);
  border-radius:10px;
  padding:8px;
}
.group input[type=range]{padding:0;}
button{
  width:100%;
  margin-top:10px;
  padding:10px;
  background:linear-gradient(180deg,rgba(74,163,255,.2),rgba(74,163,255,.08));
  border:1px solid rgba(74,163,255,.6);
  border-radius:12px;
  color:#fff;
  font-weight:600;
  cursor:pointer;
}
button:hover{filter:brightness(1.1);}
.canvasWrap{
  background:#0b0d12;
  border:1px solid var(--border);
  border-radius:var(--radius);
  box-shadow:var(--shadow);
  display:flex;
  align-items:center;
  justify-content:center;
}
canvas{
  max-width:100%;
  max-height:100%;
  background:#fff;
  border-radius:10px;
}
.small{
  font-size:11px;
  color:var(--muted);
  margin-top:4px;
}
</style>
</head>

<body>
<div class="container">
  <div class="panel">
    <h2>Adobe-style Glitch Poster</h2>

    <div class="group">
      <label>文字（留空则使用图片）</label>
      <textarea id="textInput">NIKE
JUST
DO
IT</textarea>
    </div>

    <div class="group">
      <label>上传图片（可选）</label>
      <input type="file" id="imgInput" accept="image/*">
    </div>

    <div class="group">
      <label>阈值 Threshold</label>
      <input type="range" id="threshold" min="0" max="255" value="150">
    </div>

    <div class="group">
      <label>行位移 Glitch X</label>
      <input type="range" id="rowShift" min="0" max="40" value="18">
    </div>

    <div class="group">
      <label>列位移 Glitch Y</label>
      <input type="range" id="colShift" min="0" max="20" value="6">
    </div>

    <div class="group">
      <label>条纹密度 Barcode Density</label>
      <input type="range" id="stripeDensity" min="2" max="40" value="14">
    </div>

    <div class="group">
      <label>切片强度 Edge Slice</label>
      <input type="range" id="sliceStrength" min="0" max="40" value="12">
    </div>

    <div class="group">
      <button onclick="render()">重新生成</button>
      <button onclick="download()">导出 PNG</button>
      <div class="small">Canvas / 无依赖 / 可直接 Vercel 部署</div>
    </div>
  </div>

  <div class="canvasWrap">
    <canvas id="canvas" width="900" height="1200"></canvas>
  </div>
</div>

<script>
const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");
let sourceImg = null;

document.getElementById("imgInput").onchange = e=>{
  const file = e.target.files[0];
  if(!file) return;
  const img = new Image();
  img.onload = ()=>{ sourceImg = img; render(); };
  img.src = URL.createObjectURL(file);
};

function drawText(){
  ctx.fillStyle="#fff";
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle="#000";
  ctx.font="bold 220px Helvetica,Arial";
  ctx.textAlign="center";
  ctx.textBaseline="middle";
  const lines = document.getElementById("textInput").value.split("\n");
  const lh = 220;
  const startY = canvas.height/2 - (lines.length-1)*lh/2;
  lines.forEach((l,i)=>{
    ctx.fillText(l, canvas.width/2, startY + i*lh);
  });
}

function applyBW(th){
  const img = ctx.getImageData(0,0,canvas.width,canvas.height);
  for(let i=0;i<img.data.length;i+=4){
    const y = 0.2126*img.data[i]+0.7152*img.data[i+1]+0.0722*img.data[i+2];
    const v = y>th?255:0;
    img.data[i]=img.data[i+1]=img.data[i+2]=v;
  }
  ctx.putImageData(img,0,0);
}

function glitch(rowShift,colShift){
  const img = ctx.getImageData(0,0,canvas.width,canvas.height);
  const w=canvas.width,h=canvas.height;
  for(let y=0;y<h;y+=8){
    if(Math.random()<0.35){
      const dx=(Math.random()*2-1)*rowShift;
      ctx.putImageData(img,dx,y,0,y,w,8);
    }
  }
  for(let x=0;x<w;x+=12){
    if(Math.random()<0.25){
      const dy=(Math.random()*2-1)*colShift;
      ctx.putImageData(img,x,dy,x,0,12,h);
    }
  }
}

function stripes(density){
  const h=canvas.height,w=canvas.width;
  let y=0, step=100/density;
  while(y<h){
    ctx.fillStyle=Math.random()>0.5?"#000":"#fff";
    ctx.fillRect(w*0.65,y,w*0.3,step);
    y+=step;
  }
}

function edgeSlice(strength){
  if(strength<=0) return;
  const img = ctx.getImageData(0,0,canvas.width,canvas.height);
  for(let i=0;i<10;i++){
    if(Math.random()<0.5){
      const y=Math.random()*canvas.height;
      const h=Math.random()*strength;
      ctx.putImageData(img,(Math.random()*2-1)*strength,y,0,y,canvas.width,h);
    }
  }
}

function render(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  if(sourceImg){
    ctx.drawImage(sourceImg,0,0,canvas.width,canvas.height);
  }else{
    drawText();
  }
  applyBW(+threshold.value);
  glitch(+rowShift.value,+colShift.value);
  stripes(+stripeDensity.value);
  edgeSlice(+sliceStrength.value);
}

function download(){
  const a=document.createElement("a");
  a.download="glitch-poster.png";
  a.href=canvas.toDataURL("image/png");
  a.click();
}

render();
</script>
</body>
</html>
